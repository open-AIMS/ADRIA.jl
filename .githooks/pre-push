#!/usr/bin/env bash
# Opt-in pre-push guard against precompilation-time regressions. CI only runs the budget
# test on tags/manual runs/manifest changes (see .github/workflows/UnitTests.yml), so this
# catches regressions before they are pushed.
# Enable once per clone:   git config core.hooksPath .githooks
# Skip for one push:       SKIP_PRECOMPILE_CHECK=1 git push     (or git push --no-verify)
#
# Runs only if the pushed commits touch ADRIA/src, ADRIA/Project.toml or the budget test,
# so most pushes pay nothing. When it runs it takes a few minutes (cold precompile of ADRIA
# without its workload in a throwaway environment plus the cold model-assembly JIT,
# ~40 s on its own on a warm package depot).
set -euo pipefail

[ "${SKIP_PRECOMPILE_CHECK:-0}" = "1" ] && exit 0

zero=0000000000000000000000000000000000000000
changed=""
while read -r _ local_sha _ remote_sha; do
    [ "$local_sha" = "$zero" ] && continue                 # branch deletion
    if [ "$remote_sha" = "$zero" ]; then base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo ""); else base=$remote_sha; fi
    [ -z "$base" ] && base=$(git rev-list --max-parents=0 "$local_sha" | tail -1)
    if diff_out=$(git diff --name-only "$base" "$local_sha" 2>/dev/null); then
        changed+=$'\n'$diff_out
    else
        # Remote tip not available locally (not fetched): be conservative and run the check.
        echo "pre-push: cannot diff against $base (not fetched?); running precompile check anyway." >&2
        changed+=$'\nADRIA/src/'
    fi
done

if ! grep -qE '^ADRIA/(src/|Project.toml|test/precompile_budget/)' <<<"$changed"; then
    exit 0
fi

root=$(git rev-parse --show-toplevel)
echo "pre-push: ADRIA source changed -> checking precompile time budget (takes a few minutes)..."
# Prefer the Julia version the repo commits a manifest for (1.12); fall back to default.
if julia +1.12 --version >/dev/null 2>&1; then JULIA=(julia +1.12); else JULIA=(julia); fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# Throwaway env so the check doesn't touch the user's environments.
"${JULIA[@]}" --project="$tmp" -e "using Pkg; Pkg.develop(path=\"$root/ADRIA\"); Pkg.add(\"Test\")"
if ! "${JULIA[@]}" --project="$tmp" "$root/ADRIA/test/precompile_budget/precompile_budget.jl"; then
    echo >&2
    echo "pre-push: PRECOMPILE TIME BUDGET EXCEEDED. Push aborted." >&2
    echo "          Override with SKIP_PRECOMPILE_CHECK=1 only if you understand why." >&2
    exit 1
fi
